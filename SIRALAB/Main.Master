<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Main.master.cs" Inherits="SIRALAB.Main" %>

<%@ Register Src="Controles/wucMensajes.ascx" TagName="wucMensajes" TagPrefix="uc1" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">

<head runat="server">
    <title>Sistema de Recepción de Análisis de Laboratorios</title>

    <link rel="shortcut icon" href="https://framework-gb.cdn.gob.mx/favicon.ico" />
    <link rel="stylesheet" type="text/css" href="https://framework-gb.cdn.gob.mx/assets/styles/main.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,400,300,600,700&amp;subset=latin" media="all" />
    <link href="style/fontawesome/css/fontawesome.min.css" rel="stylesheet" />
    <link href="style/fontawesome/css/solid.min.css" rel="stylesheet" />

    <style type="text/css">
        .seprecon {
            position: fixed;
            top: 20%;
            left: 43%;
            width: 20%;
            padding: .8em 0;
            z-index: 50001;
            background-color: #FFF;
            text-align: center;
            -webkit-border-radius: 5px 5px 0 0;
            -moz-border-radius: 5px 5px 0 0;
            border-radius: 5px;
            border: 1px solid #000;
            -moz-opacity: 1;
            -webkit-opacity: 1;
            filter: alpha(opacity = 100);
            opacity: 1;
        }

        .se-pre-con {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background-color: #777;
            -moz-opacity: 0.4;
            -webkit-opacity: 0.4;
            filter: alpha(opacity = 40);
            opacity: 0.4;
        }
    </style>
    
    <script src="https://ajax.googleapis.com/ajax/libs/webfont/1/webfont.js" type="text/javascript" async=""></script>
    <script src="https://framework-gb.cdn.gob.mx/assets/scripts/plugins.js"></script>
    <script src="https://framework-gb.cdn.gob.mx/assets/scripts/main.js"></script>
    <script type="text/javascript" src="https://framework-gb.cdn.gob.mx/assets/scripts/vendor/pace.min.js"></script>

    <script src="https://framework-gb.cdn.gob.mx/gobmx.js"></script>
    <script src="https://code.jquery.com/jquery-1.12.3.js"></script>
    <script src="js/ValidadorRequerido.js"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server" enctype="multipart/form-data" method="post" role="form">
        <asp:ScriptManager ID="tsm" runat="server" EnablePartialRendering="true" EnableScriptGlobalization="true" AsyncPostBackTimeout="300"></asp:ScriptManager>
        <main class="page">

            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <asp:UpdatePanel ID="upMensaje" runat="server" UpdateMode="Conditional" ChildrenAsTriggers="false">
            <Triggers>
                <asp:AsyncPostBackTrigger ControlID="wucMensaje" EventName="Devolucion" />
                <asp:AsyncPostBackTrigger ControlID="wucMensaje" EventName="Cerrar" />
            </Triggers>
            <ContentTemplate>
                <uc1:wucMensajes ID="wucMensaje" runat="server" />
            </ContentTemplate>
        </asp:UpdatePanel>
        <asp:Panel ID="pnlProgress" runat="server">
            <div class="se-pre-con"></div>
            <div class="seprecon">
                <img src="image/loader_light.gif" />&nbsp;
                <span>Espere un momento...</span>
            </div>
        </asp:Panel>
        <asp:ModalPopupExtender ID="modalExtender" BehaviorID="modalExtender" runat="server" TargetControlID="pnlProgress" PopupControlID="pnlProgress" BackgroundCssClass="popUpBackground"></asp:ModalPopupExtender>
    </form>
    
    <script>
        (function (i, s, o, g, r, a, m) {
            i['GoogleAnalyticsObject'] = r; i[r] = i[r] || function () {
                (i[r].q = i[r].q || []).push(arguments)
            }, i[r].l = 1 * new Date(); a = s.createElement(o),
            m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m)
        })(window, document, 'script', '//www.google-analytics.com/analytics.js', 'ga');

        ga('create', 'UA-48768408-3', 'auto');
        ga('send', 'pageview');
    </script>

    <script type="text/javascript">
        Sys.WebForms.PageRequestManager.getInstance().add_beginRequest(showPopup);
        Sys.WebForms.PageRequestManager.getInstance().add_endRequest(hidePopup);

        function showPopup(sender, args) {
            var ModalControl = 'modalExtender';
            try {
                $find(ModalControl).show();
                $("div[id*=UpdateProgress]").removeAttr("style");
            } catch (e) { }
        }

        function hidePopup(sender, args) {
            var ModalControl = 'modalExtender';
            try { $find(ModalControl).hide(); } catch (e) { }
        }

    </script>


    <script>
        $(document).ready(function () {
            var percent = 0;

            timerId = setInterval(function () {
                //increment progress bar
                percent += 5;
                $('.pace-progress').css('width', percent + '%');
                $('.pace-progress').attr('aria-valuenow', percent);
                //  $('.pace-progress').text(percent+'%');

                //complete
                if (percent == 100) {
                    clearInterval(timerId);
                }

            }, 1000);

            
        });
    </script>
</body>
</html>
