                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox22">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>El presente informe mensual fue elaborado con base en los registros que obran al </Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Label>Fecha</Label>
                                  <Value>=FormatDateTime(Fields!AnalisisFechaFirma.Value, DateFormat.LongDate)</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> a las </Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Label>Hora</Label>
                                  <Value>=FormatDateTime(Fields!AnalisisFechaFirma.Value, DateFormat.LongTime)</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> horas, en el Sistema de Recepción de Análisis de Laboratorio (SIRALAB) y se expide sólo para fines fiscales.</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox22</rd:DefaultName>
                          <Style>
