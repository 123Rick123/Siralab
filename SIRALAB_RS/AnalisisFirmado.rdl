                  <Height>11cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Subreport Name="SubreportHojaCabecera">
                          <ReportName>AnalisisHeader</ReportName>
                          <Parameters>
                            <Parameter Name="AnalisisID">
                              <Value>=Fields!AnalisisIdentificador.Value</Value>
                            </Parameter>
                            <Parameter Name="ParrafoDescripcion">
                              <Value>=IIf(Fields!AnalisisMuestraEsCompuesta.Value, IIf(DateDiff(DateInterval.Day,CDate(FormatDateTime(Fields!AnalisisFechaInicio.Value, DateFormat.ShortDate)), CDate(FormatDateTime(Fields!AnalisisFechaFin.Value, DateFormat.ShortDate))) = 0, "A continuación se presenta el reporte de los resultados de las determinaciones analíticas realizadas por este laboratorio en los muestreos del día " &amp; CStr(Day(Fields!AnalisisFechaFin.Value)) &amp; " de " &amp; MonthName(Month(Fields!AnalisisFechaFin.Value)) &amp; " del " &amp; Year(Fields!AnalisisFechaFin.Value) &amp; ".", "A continuación se presenta el reporte de los resultados de las determinaciones analíticas realizadas por este laboratorio en los muestreos entre los días " &amp; CStr(Day(Fields!AnalisisFechaInicio.Value)) &amp; " y " &amp; CStr(Day(Fields!AnalisisFechaFin.Value)) &amp; " de " &amp; MonthName(Month(Fields!AnalisisFechaFin.Value)) &amp; " del " &amp; Year(Fields!AnalisisFechaFin.Value) &amp; "."),"A continuación se presenta el reporte del resultado de la muestra de agua realizada por este laboratorio el día " &amp; CStr(Day(Fields!AnalisisFechaFin.Value)) &amp; " de " &amp; StrConv (MonthName(Month(Fields!AnalisisFechaFin.Value)),VbStrConv.ProperCase) &amp;  " del " &amp; Year(Fields!AnalisisFechaFin.Value) &amp; ".")</Value>
                            </Parameter>
                            <Parameter Name="EsCompuesta">
                              <Value>=IIf(Fields!AnalisisMuestraEsCompuesta.Value,false,true)</Value>
                            </Parameter>
                          </Parameters>
                          <NoRowsMessage>=""</NoRowsMessage>
                          <KeepTogether>true</KeepTogether>
                          <OmitBorderOnPageBreak>true</OmitBorderOnPageBreak>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <Language>es-MX</Language>
                          </Style>
                        </Subreport>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
