<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" executionTimeout="900000" maxRequestLength="100000000" useFullyQualifiedRedirectUrl="false" minFreeThreads="8" minLocalRequestFreeThreads="4" appRequestQueueLimit="100" enableVersionHeader="true" />
    <authentication mode="None" />
    <authorization>
      <allow users="?" />
    </authorization>
  </system.web>
  <appSettings>
    <add key="PathArchivos" value="C:\Tmp\SIRALAB_Docs\" />
  </appSettings>
</configuration>