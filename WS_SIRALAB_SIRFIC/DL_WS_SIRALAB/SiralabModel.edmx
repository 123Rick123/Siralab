[vw_LaboratoriosPALA].[NumeroExterior] AS [NumeroExterior], 
[vw_LaboratoriosPALA].[NumeroInterior] AS [NumeroInterior], 
[vw_LaboratoriosPALA].[CP] AS [CP], 
[vw_LaboratoriosPALA].[Contacto] AS [Contacto], 
